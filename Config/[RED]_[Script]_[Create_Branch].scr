# ScriptVersion:005 MinVersion:8310 MaxVersion:* TargetType:* ModelType:* ScriptType:GIT
import os
import subprocess
from pathlib import Path
import sys

def main() -> int:
    """Launches the CICD Python script"""
    try:
        # Validate environment variable
        program_files = os.environ.get("ProgramFiles")
        if not program_files:
            raise EnvironmentError("Environment variable 'ProgramFiles' is not set.")

        # Construct paths
        file: str = os.environ.get('WSL_TASK_NAME','')
        script_name = Path(__file__).stem + ".py"
        file_path = os.path.join(program_files, "WhereScape", "GIT", "Python", "ed3d_create_feature_branch.py")
        if not os.path.exists(file_path):
            raise FileNotFoundError(f"Script file not found: {file_path}")

        base_dir = os.path.join(program_files, "WhereScape", "GIT", "Python", "python_embedded")
        python_exe_path = os.path.join(base_dir, "python.exe")
        if not os.path.exists(python_exe_path):
            raise FileNotFoundError(f"Python executable not found: {python_exe_path}")
            
        command = [
            python_exe_path,
            file_path,
            "--ws3d_repository",
            os.environ.get('WSL_SERVER',''),
            "--ws_app",
            "WSRED",
        ]

        returnvalue = subprocess.Popen(command)

        if returnvalue.stderr != "":
            raise RuntimeError(returnvalue.stdout)

        return 1

    except Exception as error:
        print(f"[ERROR] {type(e).__name__}: {e}", file=sys.stderr)
        return -1

if __name__ == "__main__":  # Runs main() if file wasn't imported.
    main()
    print(1)
